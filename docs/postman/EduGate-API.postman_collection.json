    {
      "name": "6 · End session",
      "description": "Runs last so a full-collection run does not revoke its own token halfway through.",
      "item": [
        {
          "name": "Logout (revoke current token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the token in use.\n\nDeliberately the LAST item in the collection: newman and Postman's Collection Runner execute items in order, and revoking mid-run would 401 everything after it."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Write to the active environment when there is one — an environment value",
                  "// otherwise shadows the collection variable and the request sends a stale blank.",
                  "const put = (k, v) => (pm.environment.name ? pm.environment : pm.collectionVariables).set(k, v);",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('revoked', () => pm.expect(pm.response.json().data.revoked).to.be.true);",
                  "put('access_token', '');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
