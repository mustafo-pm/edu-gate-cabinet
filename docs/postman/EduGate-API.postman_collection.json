                "v1",
                "payments",
                "confirm"
              ]
            },
            "description": "An amount larger than the PSP's prepaid deposit. Nothing is written — the whole database transaction rolls back.\n\nNeeds a live `check_id`, so run Check first."
          },
          "response": [],
          "event": [
