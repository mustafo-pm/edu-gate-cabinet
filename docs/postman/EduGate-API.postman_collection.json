    {
      "name": "1 · Auth",
      "item": [
        {
          "name": "Login (API key → bearer token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key_id\": \"{{key_id}}\",\n  \"secret\": \"{{secret}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Exchange an API key pair for a Sanctum bearer token.\n\nThe token carries an ability of `env:sandbox` or `env:live`, so a sandbox key can never act on live data.\n\nRun this first — the test script stores `access_token` for every other request."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Write to the active environment when there is one — an environment value",
                  "// otherwise shadows the collection variable and the request sends a stale blank.",
                  "const put = (k, v) => (pm.environment.name ? pm.environment : pm.collectionVariables).set(k, v);",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('envelope is ok', () => pm.expect(b.status).to.eql('ok'));",
                  "pm.test('returns a bearer token', () => {",
                  "    pm.expect(b.data.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(b.data.token_type).to.eql('Bearer');",
                  "});",
                  "put('access_token', b.data.access_token);",
                  "console.log('Signed in as', b.data.psp.name, '·', b.data.environment);"
                ]
              }
            }
          ]
        }
      ]
    },
