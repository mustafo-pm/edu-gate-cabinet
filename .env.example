APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Origins allowed to read /api/public/site (the marketing site's partner wall
# and trust figures). Comma separated; defaults to the edu-gate.uz origins.
# CORS_ALLOWED_ORIGINS=https://edu-gate.uz,https://www.edu-gate.uz

# Aloqabank API simulator — stands in for the bank until we have sandbox access.
# Forced off whenever APP_ENV=production, regardless of these values.
# SIMULATOR_ALOQABANK_ENABLED=true
# SIMULATOR_ALOQABANK_SETTLE_AFTER=10   # seconds an order stays "Введен"
# SIMULATOR_ALOQABANK_TIMEOUT=30        # how long the …9999 account hangs

# Settling tuition out to institutions. SETTLEMENT_START_AT guards the backstop
# on first deploy: payments confirmed before this moment are never auto-settled,
# because they were almost certainly transferred by hand.
# SETTLEMENT_AUTO=true
# SETTLEMENT_START_AT="2026-08-06 00:00:00"

# Print the seeded logins on the sign-in pages. NOT keyed on APP_ENV on purpose:
# the staging cabinet runs as `local` so the simulator's routes register, and an
# environment check would publish this hint on a publicly reachable page.
# DEMO_SHOW_CREDENTIALS=true

# Shared hosting has no process supervisor, so let the per-minute scheduler cron
# drain the queue. Settlement is queued — without this or a real worker,
# payments succeed and no bank transfer is ever created.
# QUEUE_DRAIN_FROM_SCHEDULER=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
